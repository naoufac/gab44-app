{
  "expo": {
    "name": "Gab44",
    "slug": "gab44",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "gab44",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf9f5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gab44.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Gab44 uses your microphone for voice readings with the council."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf9f5"
      },
      "package": "com.gab44.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": "https://gab44.com"
      }
    }
  }
}
